{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Web App (Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "cwd": "."
    },
    {
      "name": "Mobile App (Expo)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 8081,
      "cwd": "./mobile"
    },
    {
      "name": "Express API Server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 5000,
      "cwd": "./server"
    }
  ]
}
