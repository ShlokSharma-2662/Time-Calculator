{
    "manifest_version": 3,
    "name": "Daily Calculations",
    "version": "1.0.0",
    "description": "Friendly. Daily Routine. Cyclic.",
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "logo.png",
            "48": "logo.png",
            "128": "logo.png"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'unsafe-inline' blob: https://apis.google.com https://www.gstatic.com https://*.firebaseapp.com; object-src 'self'"
    },
    "icons": {
        "16": "logo.png",
        "48": "logo.png",
        "128": "logo.png"
    },
    "permissions": [
        "storage"
    ]
}
